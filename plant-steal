local freezeEnabled = false
local savedPosition = nil
local freezeConnection = nil

PlayerTab:CreateToggle({
    Name = "Freeze Position (Anti Steal)",
    CurrentValue = false,
    Flag = "FreezePosition",
    Callback = function(Value)
        freezeEnabled = Value

        if Value then
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                savedPosition = lp.Character.HumanoidRootPart.CFrame
                Rayfield:Notify({
                    Title = "Position Saved",
                    Content = "You will be returned here if moved",
                    Duration = 4
                })
            end

            freezeConnection = RunService.Heartbeat:Connect(function()
                if not freezeEnabled or not savedPosition then return end
                if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end

                local root = lp.Character.HumanoidRootPart
                local distance = (root.Position - savedPosition.Position).Magnitude

                if distance > 15 then
                    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Linear)
                    local tween = TweenService:Create(root, tweenInfo, {CFrame = savedPosition})
                    tween:Play()
                end
            end)

        else
            if freezeConnection then
                freezeConnection:Disconnect()
                freezeConnection = nil
            end
            savedPosition = nil
        end
    end,
})

